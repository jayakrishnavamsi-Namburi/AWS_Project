# ==========================================
# SecureProctor MERN - Global Environment Config
# ==========================================

# Application Environment
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=MONGODB_URI=mongodb+srv://jayakrishnavamsin_db_user:VMBex6v5cEa2kc33@cluster0.lwpeg3b.mongodb.net/?appName=Cluster0

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_secureproctor_change_in_production_min32chars
COOKIE_SECRET=super_secret_cookie_key_secureproctor_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# CORS & Client URLs
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api/v1

# Storage & Uploads
MEDIA_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE=52428800 # 50MB in bytes

# WebRTC & STUN/TURN Configuration
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=300

# Proctoring & Violation Policies
PROCTOR_WARNING_THRESHOLD=3
PROCTOR_AUTOSUBMIT_THRESHOLD=5
PROCTOR_FACE_ABSENT_SECS=5
PROCTOR_MULTIPLE_FACES_SECS=3
PROCTOR_HEAD_DEVIATION_SECS=4
PROCTOR_AUDIO_NOISE_THRESHOLD=0.35

# Video & Evidence Recording
RECORDING_ENABLED=false
RECORDING_RETENTION_DAYS=30
