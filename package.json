{
  "name": "secureproctor-mern",
  "version": "1.0.0",
  "description": "Enterprise-Grade AI-Proctored Online Examination System",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "test:persistence": "node scripts/test-persistence.js",
    "seed:admin": "npm run seed:admin --workspace=server",
    "seed:demo": "npm run seed:demo --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "proctoring",
    "examination",
    "mern",
    "ai",
    "webrtc",
    "mediapipe",
    "security"
  ],
  "author": "SecureProctor Architect",
  "license": "ISC"
}
